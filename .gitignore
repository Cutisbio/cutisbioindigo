# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 키가 비어 있는 견본은 올린다 — 어떤 키가 필요한지 알리기 위해서다
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 이전 Vite 템플릿 잔재 (빈 node_modules 폴더만 남아 있음)
/geo-template/

# GCP 업로드용 용어집 TSV — `npm run glossary:export` 로 언제든 다시 만듭니다.
# 원본(content/glossary.json)만 관리하면 되고, 이 파일이 낡는 일을 막습니다.
/content/glossary-gcp/

# 번역 비교 보고서 — 키가 있는 엔진에 따라 내용이 달라지는 생성물입니다.
# `npm run translate:compare` 로 언제든 다시 만듭니다.
/docs/translation-comparison.md
